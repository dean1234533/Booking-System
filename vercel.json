{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/cron-reminders.js": {
      "maxDuration": 30
    },
    "api/send-reminder-email.js": {
      "maxDuration": 10
    }
  }
}