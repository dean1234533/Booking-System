rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Top-level slots (read by BookingForm) ─────────────────────────────────
    match /slots/{slotId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Top-level bookings (Dashboard queries these filtered by barberId) ──────
    match /bookings/{bookingId} {
      allow read: if request.auth != null && resource.data.barberId == request.auth.uid;
      allow create: if true;
      allow update, delete: if request.auth != null && resource.data.barberId == request.auth.uid;
    }

    // ── Booking-link slug uniqueness index (bookrightly.co.uk/{slug}) ──────────
    // Public read — powers the live "is this link available" hint in onboarding
    // and settings. Writes are exclusively via the claimBookingSlug Cloud
    // Function (admin SDK bypasses these rules) — a transaction is the only way
    // to enforce cross-document uniqueness, which rules alone can't express.
    match /bookingSlugs/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // ── Staff collection-group read ─────────────────────────────────────────
    // BarberProfile.jsx falls back to collectionGroup(db,"staff").where("uid","==",id)
    // when a staff member's page is opened directly (their id isn't a top-level
    // barbers doc). The nested `match /barbers/{barberId}/staff/{staffId}` rule
    // below only authorizes direct get()s / same-collection queries — Firestore
    // requires this separate {path=**} wildcard rule to also cover collection-
    // group queries across every shop's staff subcollection.
    match /{path=**}/staff/{staffId} {
      allow read: if true;
    }

    // ── Barbers ───────────────────────────────────────────────────────────────
    match /barbers/{barberId} {
      // Public read — needed for all tenant pages, booking, search
      allow read: if true;
      // Only the authenticated owner can write their own document
      allow write: if request.auth != null && request.auth.uid == barberId;

      // ── Reviews — anyone can post, only owner can delete ─────────────────
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if request.auth != null && request.auth.uid == barberId;
      }

      // ── Food diary — anyone can submit via the shared link ────────────────
      match /foodDiarySubmissions/{subId} {
        allow read: if request.auth != null && request.auth.uid == barberId;
        allow create: if true;
        allow update, delete: if request.auth != null && request.auth.uid == barberId;
      }

      // ── Check-in — anyone can submit via the shared link ─────────────────
      match /checkInSubmissions/{subId} {
        allow read: if request.auth != null && request.auth.uid == barberId;
        allow create: if true;
        allow update, delete: if request.auth != null && request.auth.uid == barberId;
      }

      // ── PAR-Q health forms — anyone can submit, only owner reads ─────────
      match /parQSubmissions/{subId} {
        allow read: if request.auth != null && request.auth.uid == barberId;
        allow create: if true;
        allow update, delete: if request.auth != null && request.auth.uid == barberId;
      }

      // ── Config (check-in questions etc.) — public read ───────────────────
      match /config/{configId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == barberId;
      }

      // ── Staff — public read (for team pages) ──────────────────────────────
      // create/delete used to allow ANY authenticated user — not just this
      // shop's owner or the staff member themselves — to create or delete a
      // staff doc under ANY shop, which let anyone plant a fake staff entry
      // on, or remove a real one from, a business they have nothing to do
      // with. Every legitimate write always has staffId == request.auth.uid
      // (self-signup and invite-claim both create their OWN doc) or
      // request.auth.uid == barberId (owner adding/removing via dashboard) —
      // the one exception, an invite-claim deleting its OLD placeholder doc
      // (a different id than the new user's own uid), now happens server-side
      // in finalizeStaffInviteClaim instead, which can safely verify it only
      // ever touches a placeholder the caller has already legitimately
      // claimed. Found + fixed 2026-08-21 during a security review.
      match /staff/{staffId} {
        allow read: if true;
        allow create, delete: if request.auth != null
          && (request.auth.uid == barberId || request.auth.uid == staffId);
        allow update: if request.auth != null
          && (request.auth.uid == barberId || request.auth.uid == staffId);
      }

      // ── Live queue — anyone can join, owner manages ───────────────────────
      // Queue joiners have no account — sessionId (handed back to them on
      // join, never exposed elsewhere) stands in for auth so a client can
      // attach their own push subscription after joining, without letting
      // them touch anything else on the doc (status, position, etc.) or
      // anyone else's entry.
      match /liveQueue/{entryId} {
        allow read: if true;
        allow create: if true;
        allow update: if (request.auth != null && request.auth.uid == barberId)
          || (resource.data.sessionId == request.resource.data.sessionId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pushSubscription"]));
        allow delete: if request.auth != null && request.auth.uid == barberId;
      }

      // ── Queue config — public read (open/closed banner) ──────────────────
      match /queueConfig/{configId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == barberId;
      }

      // ── Haircut memory — owner reads, anyone adds (via FAB) ─────────────
      match /haircutMemories/{phoneKey}/cuts/{cutId} {
        allow read: if request.auth != null && request.auth.uid == barberId;
        allow create: if true;
        allow update, delete: if request.auth != null && request.auth.uid == barberId;
      }

      // ── Colour palettes — public read, owner writes ───────────────────────
      match /colourPalettes/{paletteId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null && request.auth.uid == barberId;

        // Client approvals — anyone can submit ──────────────────────────────
        match /approvals/{approvalId} {
          allow read: if request.auth != null && request.auth.uid == barberId;
          allow create: if true;
          allow update, delete: if request.auth != null && request.auth.uid == barberId;
        }
      }

      // ── Workout plans — public read (clients view via link) ──────────────
      match /workoutPlans/{planId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null && request.auth.uid == barberId;
      }

      // ── Bookings (subcollection) — anyone can create, owner manages ───────
      match /bookings/{bookingId} {
        allow read: if request.auth != null && request.auth.uid == barberId;
        allow create: if true;
        allow update, delete: if request.auth != null && request.auth.uid == barberId;
      }

      // ── Day planner — owner only ──────────────────────────────────────────
      // Two separate rules needed: a `match` on the nested jobs subcollection
      // does NOT implicitly cover the dayPlan/{dayKey} parent document itself
      // (deleteBarberAccountData deletes that parent doc directly, which was
      // hitting the deny-all catch-all with no rule for this exact path).
      match /dayPlan/{dayKey} {
        allow read, write: if request.auth != null && request.auth.uid == barberId;
      }
      match /dayPlan/{dayKey}/jobs/{jobId} {
        allow read, write: if request.auth != null && request.auth.uid == barberId;
      }

      // ── Quotes ── /quote-view/ is an unauthenticated share link that gets
      // ONE quote by its (unguessable) id, same trust model as staff invite
      // links — so `get` is public. `list` (the owner's own quotes tab,
      // which enumerates the whole collection) stays owner-only, otherwise
      // a public `read: true` would let anyone list every client's name,
      // email and address across every quote, not just one they hold the
      // link to.
      match /quotes/{quoteId} {
        allow get: if true;
        allow list: if request.auth != null && request.auth.uid == barberId;
        allow write: if request.auth != null && request.auth.uid == barberId;
      }

      // ── Food generator links — public read (clients validate token), owner writes ──
      match /foodGeneratorLinks/{token} {
        allow read: if true;
        allow create, update, delete: if request.auth != null && request.auth.uid == barberId;
      }

      // ── Income & Expenses (Tax & Finance Tab) — owner only ────────────────
      match /income/{incomeId} {
        allow read, write: if request.auth != null && request.auth.uid == barberId;
      }

      match /expenses/{expenseId} {
        allow read, write: if request.auth != null && request.auth.uid == barberId;
      }

      // ── Invoices (Tax & Finance Tab) — owner only ──────────────────────────
      match /invoices/{invoiceId} {
        allow read, write: if request.auth != null && request.auth.uid == barberId;
      }

      // ── Calendar Settings (Google Calendar sync) — owner only ──────────────
      match /calendarSettings/{settingsId} {
        allow read, write: if request.auth != null && request.auth.uid == barberId;
      }

      // ── Clients (PT feature) — owner only ──────────────────────────────────
      match /clients/{clientId} {
        allow read, write: if request.auth != null && request.auth.uid == barberId;

        // ── Client messages ───────────────────────────────────────────────────
        match /messages/{messageId} {
          allow read, write: if request.auth != null && request.auth.uid == barberId;
        }

        // ── Client activities (workouts) ──────────────────────────────────────
        match /activities/{activityId} {
          allow read, write: if request.auth != null && request.auth.uid == barberId;
        }

        // ── Consultation notes (voice recordings) ─────────────────────────────
        match /consultationNotes/{noteId} {
          allow read, write: if request.auth != null && request.auth.uid == barberId;
        }

        // ── Nutrition plans (public read so clients view via link) ────────────
        match /nutritionPlans/{planId} {
          allow read: if true;
          allow create, update, delete: if request.auth != null && request.auth.uid == barberId;
        }

        // ── Progress entries — clients write anonymously via client portal ─────
        match /progressEntries/{entryId} {
          allow create: if true;
          allow read, update, delete: if request.auth != null && request.auth.uid == barberId;
        }
      }

      // ── Favorite exercises (Exercise Generator) — owner only ───────────────
      match /favoriteExercises/{exerciseId} {
        allow read, write: if request.auth != null && request.auth.uid == barberId;
      }

      // ── Custom foods (Nutrition Tab) — owner only ──────────────────────────
      match /customFoods/{foodId} {
        allow read, write: if request.auth != null && request.auth.uid == barberId;
      }

      // ── Notepad categories — owner only ────────────────────────────────────
      match /notepadCategories/{categoryId} {
        allow read, write: if request.auth != null && request.auth.uid == barberId;
      }

      // ── PT availability slots — owner manages, public read + client can book ─
      match /ptSlots/{slotId} {
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == barberId;
        allow update: if (request.auth != null && request.auth.uid == barberId)
                      || (resource.data.status == "available"
                          && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status', 'clientName', 'purpose', 'bookedAt']));
      }

      // ── Enquiries (Decorator / public contact form) — anyone creates, owner reads ─
      match /enquiries/{enquiryId} {
        allow create: if true;
        allow read, update, delete: if request.auth != null && request.auth.uid == barberId;
      }

      // ── Notifications inbox — anyone creates (bookings from unauthed visitors), owner manages ─
      match /notifications/{notifId} {
        allow create: if true;
        allow read, update, delete: if request.auth != null && request.auth.uid == barberId;
      }

      // ── Integrations (Outlook tokens etc) — owner only, never public ────────
      match /integrations/{integrationId} {
        allow read, write: if request.auth != null && request.auth.uid == barberId;
      }

      // ── Automation schedules + sent history — owner only ───────────────────
      match /automationSchedules/{scheduleId} {
        allow read, write: if request.auth != null && request.auth.uid == barberId;
        match /sentHistory/{historyId} {
          allow read, write: if request.auth != null && request.auth.uid == barberId;
        }
      }
    }

    // ── Platform feedback — anyone submits, no public read ───────────────────
    match /platformFeedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // ── Signup/onboarding funnel events — anyone logs, no public read ────────
    match /funnelEvents/{eventId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // ── Short payment-link redirects — public read, server-only write ────────
    // Maps a short bookrightly.co.uk/pay/{id} to the real (very long) Stripe
    // Checkout URL, purely so the link handed to a client is short and
    // presentable. Only the Worker (via its admin token) ever writes these.
    match /paymentLinks/{linkId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
