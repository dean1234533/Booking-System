{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "booking-system",
  "compatibility_date": "2026-05-19",
  "assets": {
    "directory": "dist",  // <-- This serves your built Vite frontend files
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  }
}