# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Built by vite.widget.config.js (see package.json's build:widget/deploy
# scripts) — regenerated from src/widget/ on every build, same as dist/.
public/widget.js

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables — never commit these
.env
.env.local
.env.production
.env.*.local

# Firebase
.firebase/
firebase-debug.log

# Functions
functions/node_modules
.vercel
.env*.local

# Android signing & build output — never commit these
twa/*.keystore
twa/*.aab
twa/*.apk
twa/android/build/
twa/android/app/build/

.dev.vars

# Generated video/audio promo assets — regenerated by the scripts in
# marketing/video/ (record-v2.cjs, cards-v2.cjs, music-v2.cjs, build-v2.cjs),
# never hand-edited. These are large binaries that bloat repo size/push time
# for no benefit — the scripts that produce them are the actual source.
marketing/video/clips/*.webm
marketing/video/assets/**/*.png
marketing/video/assets/*.wav
marketing/video/*.mp4
marketing/*.mp4
