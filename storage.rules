rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Haircut memory photos — barber uploads, public read
    match /haircutMemory/{barberId}/{phone}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == barberId;
    }

    // Client history photos (hairdresser colour/style records) — owner uploads, public read
    match /clientHistory/{barberId}/{phone}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == barberId;
    }

    // Job-request photo attachments — submitter has no account (public job
    // request forms, e.g. PlumberTemplate), so writes here are intentionally
    // open, scoped to this one subpath, and capped to small images only.
    match /barbers/{barberId}/enquiryPhotos/{enquiryId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // General barber uploads (logos, hero images, etc.)
    match /barbers/{barberId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == barberId;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
