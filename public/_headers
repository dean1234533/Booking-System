# Content-hashed bundles never change — cache them forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML (and SPA routes) must always revalidate so a new deploy is seen immediately.
# Content-Security-Policy kept identical to worker.js's CSP constant — see that
# file's comment for exactly which real integration each origin covers. THIS
# FILE governs any request Cloudflare's Workers Assets serves directly from the
# `assets` binding (wrangler.jsonc), which happens BEFORE worker.js's fetch
# handler ever runs — worker.js's own header logic never applies to those
# requests, so this copy has to be kept in sync by hand whenever the CSP
# changes there. A stale copy here was the real cause of CSP violations and
# stuck-forever caching that looked like a Cloudflare platform bug for most of
# a session (2026-08-21) — worker.js and firebase.json were both already
# correct, but neither one governs assets-first-served requests at all.
/*
  Cache-Control: no-store, no-cache, must-revalidate
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://js.stripe.com 'sha256-/l4ajQ/L5o91xPlHq4mEOMH1ogoGzmHPkFKthjI+yCE=' 'sha256-9ejfpz7uMUXlOkkTvGSw4HuN9GzhSn7q8XoX0+rR/j4='; style-src 'self' 'unsafe-inline' https://fonts.bunny.net https://fonts.googleapis.com; font-src 'self' https://fonts.bunny.net https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; worker-src 'self' blob:; connect-src 'self' https://*.googleapis.com https://firebasestorage.googleapis.com https://api.stripe.com https://m.stripe.network https://q.stripe.com https://us-central1-booking-system-cdce0.cloudfunctions.net https://*.a.run.app https://nominatim.openstreetmap.org; frame-src https://js.stripe.com https://hooks.stripe.com https://*.firebaseapp.com; object-src 'none'; base-uri 'self'; form-action 'self'
